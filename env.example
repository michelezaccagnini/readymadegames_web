# Email Configuration for Contact Form
# These are REQUIRED for the contact form to work

# Your Gmail address (e.g., yourname@gmail.com)
EMAIL_USER=your-email@gmail.com

# Your Gmail App Password (NOT your regular password!)
# To get an App Password:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to https://myaccount.google.com/security
# 3. Click "App passwords" under "Signing in to Google"
# 4. Select "Mail" as the app
# 5. Copy the 16-character password generated
EMAIL_PASS=your-16-char-app-password

# Email address to receive contact form submissions
EMAIL_TO=info@readymade.games

